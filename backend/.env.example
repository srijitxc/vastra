# Resend: create an API key and verify the sender domain/address first.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Twilio: use an SMS-capable number in E.164 format, such as +1...
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Admin portal credentials. Set real values in .env, never in this example.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
ADMIN_SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
